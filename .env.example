RELAY_PORT=4310
RELAY_HOST=127.0.0.1
RELAY_DB=data/relay.db
# Local inference only. Leave both empty to use the explicit template workflow.
# Docker Model Runner injects these through Compose's models mapping.
RELAY_MODEL_URL=
RELAY_MODEL_NAME=
# Exact trusted parent origins for desktop embedding, separated by commas.
# Empty means same-origin framing only.
RELAY_EMBED_ORIGINS=
