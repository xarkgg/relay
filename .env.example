RELAY_PORT=4310
RELAY_HOST=127.0.0.1
RELAY_DB=data/relay.db
# Local inference only. Leave both empty to use the explicit template workflow.
# Docker Model Runner injects these through Compose's models mapping.
RELAY_MODEL_URL=
RELAY_MODEL_NAME=
# Exact trusted parent origins for desktop embedding, separated by commas.
# Empty means same-origin framing only.
RELAY_EMBED_ORIGINS=
# Local device activation. Set all three from the operator's hosted configuration.
RELAY_COMMERCE_ORIGIN=
RELAY_ENTITLEMENT_PUBLIC_KEY=
RELAY_ENTITLEMENT_KID=

# Hosted Pi account/purchase service. Features stay disabled without configuration.
RELAY_PI_AUTH_ENABLED=0
RELAY_PI_CHECKOUT_ENABLED=0
RELAY_PI_NETWORK=Pi Testnet
RELAY_PI_SANDBOX=1
RELAY_PI_API_KEY=
RELAY_PI_MERCHANT_ADDRESS=
RELAY_PI_PRICE=
RELAY_SESSION_SECRET=
RELAY_DATABASE_URL=
RELAY_PG_TLS_VERIFY=1
RELAY_COMMERCE_URL=http://127.0.0.1:4311
# Local storefront development only. Vercel never falls back to this store.
RELAY_COMMERCE_PGLITE_DIR=data/commerce
RELAY_DEVICE_ACTIVATION_ENABLED=0
RELAY_ENTITLEMENT_PRIVATE_KEY=
